# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MySQL 8.0+ Connection Configuration (Optional - Sample Preview mode activates when unset)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_parking_db

# MongoDB NoSQL Event Log Configuration (Optional)
MONGODB_URI=
MONGODB_DATABASE=smart_parking_events

# Admin Passcode for RBAC Management (Optional - use First-Run Claim UI if unset)
ADMIN_PASSCODE=
